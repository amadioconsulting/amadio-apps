<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_compliance_confirmed" model="mail.template">
        <field name="name">Shipment: Compliance Document Confirmed</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="subject">Compliance Confirmed: {{ object.name }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #1F2937;">
    <p><strong>Compliance Document Confirmed</strong></p>
    <p>Shipment <strong>{{ object.name }}</strong> validated with compliance acknowledgment confirmed.</p>
    <table style="width: 100%; border-collapse: collapse; margin-top: 12px;">
        <tr><td style="padding: 6px 12px; background: #F3F4F6; font-weight: bold; width: 35%;">Shipment</td><td style="padding: 6px 12px;">{{ object.name }}</td></tr>
        <tr><td style="padding: 6px 12px; background: #F3F4F6; font-weight: bold;">Customer</td><td style="padding: 6px 12px;">{{ object.partner_id.name if object.partner_id else 'N/A' }}</td></tr>
        <tr><td style="padding: 6px 12px; background: #F3F4F6; font-weight: bold;">Validated by</td><td style="padding: 6px 12px;">{{ user.name }}</td></tr>
        <tr><td style="padding: 6px 12px; background: #F3F4F6; font-weight: bold;">Date</td><td style="padding: 6px 12px;">{{ format_datetime(datetime.datetime.now()) }}</td></tr>
    </table>
    <p style="margin-top: 16px; color: #6B7280; font-size: 12px;">Generated by Pre-Shipment Document Compliance — amadio.io</p>
</div>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
